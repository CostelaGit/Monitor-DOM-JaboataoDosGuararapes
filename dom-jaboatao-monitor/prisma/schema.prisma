generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Edition {
  id                     String       @id @default(cuid())
  url                    String       @unique
  slug                   String
  publishedDate          DateTime
  publishedDateStr       String
  editionNumber          String
  romanYear              String       @default("")
  title                  String
  editionType            String       @default("ORDINARIA") // ORDINARIA | EXTRAORDINARIA | SUPLEMENTAR
  isExtraOrSupplementary Boolean      @default(false)
  extraReason            String?
  executiveSummary       String       // JSON array de topicos resumidos
  aiSummary              String?
  rawText                String
  totalActs              Int          @default(0)
  totalNormative         Int          @default(0)
  totalPersonnel         Int          @default(0)
  totalContracts         Int          @default(0)
  totalOthers            Int          @default(0)
  totalAppointments      Int          @default(0)
  totalDismissals        Int          @default(0)
  totalMonetaryValue     Float        @default(0)
  acts                   Act[]
  attachments            Attachment[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([publishedDateStr])
  @@index([isExtraOrSupplementary])
}

model Act {
  id            String       @id @default(cuid())
  editionId     String
  edition       Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  externalId    String?
  sourceType    String?
  category      String       // LEIS_E_ATOS_NORMATIVOS | ATOS_DE_PESSOAL | CONTRATOS_EDITAIS_AVISOS | OUTROS
  subType       String
  department    String
  actNumber     String?
  title         String
  summary       String
  content       String
  monetaryValue Float?
  metadataJson  String?
  orderIndex    Int          @default(0)
  attachments   Attachment[]

  @@index([editionId])
  @@index([category])
  @@index([department])
}

model Attachment {
  id        String  @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  actId     String?
  act       Act?    @relation(fields: [actId], references: [id], onDelete: SetNull)
  label     String
  url       String

  @@index([editionId])
  @@index([actId])
}

model SyncLog {
  id                    String    @id @default(cuid())
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?
  status                String    // RUNNING | SUCCESS | ERROR
  pagesScanned          Int       @default(0)
  newEditionsCount      Int       @default(0)
  extraEditionsDetected Int       @default(0)
  errorMessage          String?
}
